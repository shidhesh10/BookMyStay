<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top" id="main-navbar">
  <div class="container-fluid navbar-container">
    
    <div class="navbar-top-row">
        
        <div class="navbar-brand">
  <a href="/listings" class="nav-link">
    <img src="https://res.cloudinary.com/dofvt4wn7/image/upload/v1766435202/ChatGPT_Image_Nov_5__2025__05_58_28_PM-removebg-preview_uhacx1.png" alt="Airbnb Logo" class="logo-img">
  </a>
</div>
        
        <div class="navbar-search-wrapper">
            <div class="search-bar-container" style="position: relative;">
    
          <form class="d-flex search-input-wrapper" role="search" action="/listings/search" method="GET">
              <input 
                  class="form-control search-input" 
                  type="search" 
                  name="q" 
                  id="searchInput" 
                  placeholder="Search destinations" 
                  autocomplete="off"
              >
              
              <button class="btn search-btn" type="submit">
                  <i class="fa-solid fa-magnifying-glass"></i>
                  <span>Search</span>
              </button>
          </form>

          <div class="suggestions-box d-none" id="suggestionsBox"></div>

          </div>
        </div>

        <div class="navbar-profile-zone">
            <a class="nav-link host-btn" href="/listings/new"><b>List your property</b></a>
            <div class="dropdown">
                <button class="btn profile-btn dropdown-toggle no-arrow" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-icon-container"><i class="fa-solid fa-user-tie"></i></div>
                </button>
                <ul class="dropdown-menu dropdown-menu-end profile-dropdown">
                    <% if(!currUser) { %>
                        <li><a class="dropdown-item bold-item" href="/signup"><b>Sign up</b></a></li>
                        <li><a class="dropdown-item" href="/login">Log in</a></li>
                    <% } else { %>
                        <li><div class="dropdown-header">Hello, <b><%= currUser.username %></b></div></li>
                        <li><hr class="dropdown-divider"></li>
                        <!-- <li><a class="dropdown-item" href="/listings/new">List Your Home</a></li> -->
                        <li><a class="dropdown-item" href="/logout">Log out</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </div>

    <% if(typeof allListings !== 'undefined') { %>
    <div class="navbar-bottom-row">
        
        <div class="filters-scroll">
            <% 
            let filters = [
                { name: "Trending", icon: "fa-fire" },
                { name: "Rooms", icon: "fa-bed" },
                { name: "Iconic Cities", icon: "fa-mountain-city" },
                { name: "Mountains", icon: "fa-mountain" },
                { name: "Castles", icon: "fa-brands fa-fort-awesome" },
                { name: "Amazing Pools", icon: "fa-person-swimming" },
                { name: "Camping", icon: "fa-campground" },
                { name: "Farms", icon: "fa-cow" },
                { name: "Arctic", icon: "fa-snowflake" },
                { name: "Doms", icon: "fa-igloo" },
                { name: "House Boat", icon: "fa-ship" },
                { name: "Deserts", icon: "fa-umbrella-beach" }
            ];
            %>
            <% for(let filter of filters) { %>
                <a href="/listings?category=<%= filter.name %>" 
                   class="filter <%= (typeof category !== 'undefined' && category === filter.name) ? 'active-filter' : '' %>">
                    <div class="filter-icon"><i class="fa-solid <%= filter.icon %>"></i></div>
                    <p class="filter-text"><%= filter.name %></p>
                </a>
            <% } %>
        </div>

        <div class="tax-toggle-box">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Total price after taxes</label>
            </div>
        </div>

    </div>
    <% } %>

  </div>
</nav>
